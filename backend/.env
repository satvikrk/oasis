# Copy this file to .env and fill in your database credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=music_streaming

# Optional: set MEDIA_DIR to serve media files from a custom folder relative to backend/
# MEDIA_DIR=media

# Port the Flask dev server will listen on (change if 5000 is in use)
PORT=5001
